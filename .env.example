# Sahaay Health — optional public configuration
# Copy this file to .env.local and fill in only the values you can provide.
# Vite exposes these values to the browser. Never put secrets in this file.

# Contact details displayed on the Contact page and in the footer.
# Leave blank until real, verified details exist. The site will then say
# that contact details are being finalised instead of inventing them.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# The enquiry form is frontend-only and always runs as a demonstration. It
# validates locally and never transmits or stores the submitted details.
